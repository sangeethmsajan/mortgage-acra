generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}
model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  password String
  createdAt DateTime @default(now())   // auto set on insert
  updatedAt DateTime @updatedAt        
}
